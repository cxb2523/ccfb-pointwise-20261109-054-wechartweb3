
WRITE_TO_DB_SECONDS=20
FRONTEND_URL=["http://localhost:5007"]
PORT=5006
CHAIN_ID=56

# reserves collector ( workers/collect.reserves.js )
# rpc url of the polygon amoy endpoint, may contain your api key ( it is always masked in the logs )
AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/<your_api_key>
# how many pair scanners run concurrently ( they share the same rpc limiter )
RESERVES_WORKERS=4
# max rpc calls per second on the endpoint
RESERVES_RPC_MAX_QPS=5
# max attempts per pair before giving up
RESERVES_RETRY_MAX_ATTEMPTS=5
# exponential backoff: delay before attempt n = RESERVES_RETRY_BASE_DELAY_MS * RESERVES_RETRY_BACKOFF_FACTOR^(n-1), capped at RESERVES_RETRY_MAX_DELAY_MS
RESERVES_RETRY_BASE_DELAY_MS=500
RESERVES_RETRY_BACKOFF_FACTOR=2
RESERVES_RETRY_MAX_DELAY_MS=30000
RESERVES_RETRY_JITTER_MS=250
# skip the pair ( and log it to log/reserves-failed.log ) after N consecutive failures
RESERVES_SKIP_AFTER_FAILURES=3
# blocks to wait from the chain head before considering data final ( reorg safety )
RESERVES_CONFIRMATIONS=12
# 0 = scan every pair of the factory, otherwise scan only the first N pairs
RESERVES_MAX_PAIRS=0